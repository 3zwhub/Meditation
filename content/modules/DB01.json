        {
          "id": "m2",
          "type": "say",
          "text": "들이쉬면서 두 주먹을 꽉 쥐세요.",
          "pauseSec": 4
        },
        {
          "id": "m3",
          "type": "say",
          "text": "내쉬면서 툭 놓으세요.",
          "pauseSec": 6
        },
        {
          "id": "m4",
          "type": "say",
          "text": "들이쉬면서 어깨를 귀 쪽으로 올리세요.",
          "pauseSec": 4
        },
        {
          "id": "m5",
          "type": "say",
          "text": "내쉬면서 툭 떨어뜨리세요.",
          "pauseSec": 6
        },
        {
          "id": "m6",
          "type": "say",
          "text": "들이쉬면서 얼굴을 찡그려 꽉 모으세요.",
